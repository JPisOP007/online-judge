# Example environment variables (copy to .env and set values)

# Django
DJANGO_SECRET_KEY=your-secret-here
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# MongoDB (use MongoDB Atlas connection string for production)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/online_judge

# Groq AI
GROQ_API_KEY=your-groq-key

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://myapp.local:3000

# Render deployment URL (set this to your Render app URL, e.g. https://your-app.onrender.com)
RENDER_EXTERNAL_URL=